{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Caso do simulador de casos clínicos",
  "description": "Estrutura de um caso. Cada caso tem duas partes: 'caso', com o que existe para ser descoberto, e 'folhaResposta', com o que é esperado do aluno. A IA so pode usar informacao presente aqui.",
  "type": "object",
  "required": ["id", "versao", "caso", "folhaResposta"],
  "properties": {
    "id": { "type": "string", "pattern": "^CASO-[0-9]{3}$" },
    "versao": { "type": "string" },
    "publicado": { "type": "boolean" },
    "caso": {
      "type": "object",
      "required": ["identificacao", "apresentacaoInicial", "anamnese", "exameFisico", "exames", "respostaPadrao", "momentos", "regras", "desfechos"],
      "properties": {
        "identificacao": {
          "type": "object",
          "required": ["titulo", "tema", "autor", "tempoEstimado"],
          "properties": {
            "titulo": { "type": "string" },
            "tema": { "type": "string" },
            "publico": { "type": "string" },
            "autor": { "type": "string" },
            "revisor": { "type": "string" },
            "tempoEstimado": { "type": "string" },
            "referencias": { "type": "array", "items": { "type": "string" } }
          }
        },
        "apresentacaoInicial": {
          "type": "object",
          "required": ["texto", "sinaisVitais", "pergunta"],
          "properties": {
            "texto": { "type": "string" },
            "sinaisVitais": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["rotulo", "valor"],
                "properties": {
                  "rotulo": { "type": "string" },
                  "valor": { "type": "string" },
                  "alterado": { "type": "boolean" }
                }
              }
            },
            "pergunta": { "type": "string" }
          }
        },
        "anamnese": {
          "type": "array",
          "description": "Cada item e um tema de pergunta com a resposta na voz do paciente. 'palavrasChave' serve ao modo de contingencia, sem IA.",
          "items": {
            "type": "object",
            "required": ["id", "tema", "resposta"],
            "properties": {
              "id": { "type": "string" },
              "tema": { "type": "string" },
              "resposta": { "type": "string" },
              "palavrasChave": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "exameFisico": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "segmento", "achado"],
            "properties": {
              "id": { "type": "string" },
              "segmento": { "type": "string" },
              "achado": { "type": "string" },
              "palavrasChave": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "exames": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "nome", "resultado"],
            "properties": {
              "id": { "type": "string", "pattern": "^EX-[0-9]{2}$" },
              "nome": { "type": "string" },
              "resultado": { "type": "string" },
              "disponivelAPartirDe": { "type": "string" },
              "imagem": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "arquivo": { "type": "string" },
                  "legenda": { "type": "string" },
                  "fonte": { "type": "string" },
                  "licenca": { "type": "string" }
                }
              },
              "palavrasChave": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "respostaPadrao": {
          "type": "object",
          "description": "O que o sistema responde quando o aluno pede algo que nao existe no caso. Impede que a IA invente dados.",
          "required": ["perguntaNaoListada", "laboratorioNaoListado", "imagemNaoListada"],
          "properties": {
            "perguntaNaoListada": { "type": "string" },
            "laboratorioNaoListado": { "type": "string" },
            "imagemNaoListada": { "type": "string" },
            "parecerEspecialista": { "type": "string" }
          }
        },
        "momentos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["codigo", "nome", "situacao", "pergunta"],
            "properties": {
              "codigo": { "type": "string", "pattern": "^M[0-9]+(-ALT)?$" },
              "nome": { "type": "string" },
              "tempo": { "type": "string" },
              "situacao": { "type": "string" },
              "sinaisVitais": { "type": "array", "items": { "type": "object" } },
              "atualizaExames": {
                "type": "array",
                "description": "Resultados que mudam neste momento. Substituem o valor anterior.",
                "items": {
                  "type": "object",
                  "required": ["id", "resultado"],
                  "properties": {
                    "id": { "type": "string" },
                    "resultado": { "type": "string" },
                    "imagem": { "type": "object" }
                  }
                }
              },
              "atualizaExameFisico": { "type": "array", "items": { "type": "object" } },
              "pergunta": { "type": "string" },
              "proximo": { "type": "string", "description": "Momento seguinte quando a conduta e ideal ou aceitavel." }
            }
          }
        },
        "regras": {
          "type": "array",
          "description": "O que acontece quando o aluno decide fora do esperado. O app muda o estado do caso pela regra; a IA apenas indica qual se aplica.",
          "items": {
            "type": "object",
            "required": ["codigo", "momento", "se", "entao", "vaiPara"],
            "properties": {
              "codigo": { "type": "string" },
              "momento": { "type": "string" },
              "se": { "type": "string" },
              "entao": { "type": "string" },
              "vaiPara": { "type": "string", "description": "Codigo de momento ou de desfecho." },
              "registrar": { "type": "boolean" }
            }
          }
        },
        "desfechos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["codigo", "texto"],
            "properties": {
              "codigo": { "type": "string", "pattern": "^D[0-9]+$" },
              "texto": { "type": "string" },
              "qualidade": { "type": "string", "enum": ["otimo", "bom", "ruim", "grave"] }
            }
          }
        }
      }
    },
    "folhaResposta": {
      "type": "object",
      "required": ["objetivos", "momentos", "caminhoIdeal", "pesos", "escala", "mensagensChave"],
      "properties": {
        "objetivos": { "type": "array", "items": { "type": "string" } },
        "momentos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["codigo", "ideal", "errosCriticos", "justificativa"],
            "properties": {
              "codigo": { "type": "string" },
              "ideal": { "type": "array", "items": { "type": "string" } },
              "aceitaveis": { "type": "array", "items": { "type": "string" } },
              "subotimas": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["conduta", "custo"],
                  "properties": {
                    "conduta": { "type": "string" },
                    "custo": { "type": "string" }
                  }
                }
              },
              "errosCriticos": { "type": "array", "items": { "type": "string" } },
              "pontosDeRaciocinio": { "type": "array", "items": { "type": "string" } },
              "justificativa": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "caminhoIdeal": { "type": "string" },
        "pesos": {
          "type": "object",
          "description": "Peso de cada momento. A soma deve ser 100. Momento ALT usa o peso do momento que substitui.",
          "additionalProperties": { "type": "number" }
        },
        "escala": {
          "type": "object",
          "description": "Percentual do peso por classificacao.",
          "properties": {
            "ideal": { "type": "number" },
            "aceitavel": { "type": "number" },
            "subotima": { "type": "number" },
            "perigosa": { "type": "number" },
            "nao_prevista": { "type": ["number", "null"] }
          }
        },
        "faixas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "de": { "type": "number" },
              "ate": { "type": "number" },
              "rotulo": { "type": "string" }
            }
          }
        },
        "mensagensChave": { "type": "array", "items": { "type": "string" } },
        "orientacoesFeedback": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
