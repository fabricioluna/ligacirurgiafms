rules_version = '2';

// Regras do banco do simulador. Modelo aberto, sem login:
// - O navegador só GRAVA: cria e atualiza tentativas e registra condutas não previstas.
// - O navegador nunca LÊ nada: nem a própria tentativa, nem a dos outros, nem a lista.
// - Cada tentativa tem um id aleatório (UUID) que ninguém consegue adivinhar; sem leitura nem
//   listagem, não há como achar a tentativa de outra pessoa para alterá-la.
// - O painel do professor (Fase 3) lê pelo servidor, com código de acesso, e não passa por estas regras.
// - Tudo o que não está liberado aqui é proibido.

service cloud.firestore {
  match /databases/{database}/documents {

    function texto(v, max) {
      return v is string && v.size() <= max;
    }

    function idValido(id) {
      return id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    match /tentativas/{tentativaId} {
      function valida(d) {
        return d.keys().hasOnly([
            'casoId', 'versaoCaso', 'modo', 'aparelhoId', 'nomeInformado', 'iniciadaEm', 'finalizadaEm',
            'caminho', 'passos', 'notaFinal', 'notaPorMomento', 'errosCriticos', 'desfecho',
            'qtdNaoPrevistas', 'atualizadaEm'
          ])
          && texto(d.casoId, 20)
          && texto(d.versaoCaso, 20)
          && d.modo in ['estatico', 'ia']
          && texto(d.aparelhoId, 40)
          && texto(d.nomeInformado, 80)
          && d.iniciadaEm is number
          && d.caminho is list && d.caminho.size() <= 12
          && d.passos is list && d.passos.size() <= 12
          && d.errosCriticos is list && d.errosCriticos.size() <= 40
          && d.atualizadaEm == request.time;
      }

      allow create: if idValido(tentativaId) && valida(request.resource.data);
      allow update: if valida(request.resource.data)
        && request.resource.data.casoId == resource.data.casoId
        && request.resource.data.aparelhoId == resource.data.aparelhoId
        && request.resource.data.iniciadaEm == resource.data.iniciadaEm;
      allow read, delete: if false;
    }

    match /respostas_nao_previstas/{id} {
      allow create: if request.resource.data.keys().hasOnly(['casoId', 'momento', 'textoDoAluno', 'em', 'revisada', 'tentativaId'])
        && texto(request.resource.data.casoId, 20)
        && texto(request.resource.data.momento, 12)
        && texto(request.resource.data.tentativaId, 40)
        && texto(request.resource.data.textoDoAluno, 400)
        && request.resource.data.textoDoAluno.size() > 0
        && request.resource.data.revisada == false
        && request.resource.data.em == request.time;
      allow read, update, delete: if false;
    }
  }
}
