# Copie este arquivo para .env.local e preencha. O .env.local nunca vai para o GitHub.
# Na Vercel, as mesmas variáveis ficam em Settings > Environment Variables.

# Chave do Gemini (aistudio.google.com). Fica só no servidor: nunca use o prefixo VITE_.
GEMINI_API_KEY=

# Opcional: troca o modelo sem mexer no código. Padrão: gemini-3.8-flash
GEMINI_MODELO=

# Só no computador: 1 usa uma IA de mentira, baseada nas palavras-chave do caso, para testar telas sem gastar.
IA_SIMULADA=

# Firebase (Configurações do projeto > Seus apps > App da Web). Não é segredo: identifica o projeto.
# Quem protege os dados são as regras em firestore.rules (o navegador só grava). Na Vercel, cadastre as mesmas quatro.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Painel do professor (Fase 3). As duas são SECRETAS e ficam só no servidor.
# Conta de serviço do Firebase: Configurações do projeto > Contas de serviço > Gerar nova chave privada.
# Cole o conteúdo inteiro do arquivo .json numa linha só.
FIREBASE_SERVICE_ACCOUNT=
# Código de acesso ao painel (mínimo de 8 caracteres).
PAINEL_CODIGO=
# Opcional: modelo usado para montar casos a partir dos PDFs. Padrão: o mesmo de GEMINI_MODELO.
GEMINI_MODELO_EXTRACAO=
