# Copie este arquivo para .env.local e preencha. O .env.local nunca vai para o GitHub.
# Na Vercel, as mesmas variáveis ficam em Settings > Environment Variables.

# Chave do Gemini (aistudio.google.com). Fica só no servidor: nunca use o prefixo VITE_.
GEMINI_API_KEY=

# Opcional: troca o modelo sem mexer no código. Padrão: gemini-3.8-flash
GEMINI_MODELO=

# Só no computador: 1 usa uma IA de mentira, baseada nas palavras-chave do caso, para testar telas sem gastar.
IA_SIMULADA=
